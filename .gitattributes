# Normalize text files
* text=auto

# Code / text
*.cs      text diff=csharp
*.shader  text
*.hlsl    text
*.cginc   text
*.json    text
*.md      text
*.uxml    text
*.uss     text
*.asmdef  text
*.asmref  text
*.ps1     text eol=crlf
*.sh      text eol=lf

# Unity YAML — merged with UnityYAMLMerge (register the "unityyamlmerge" merge driver in your git config)
*.unity       text eol=lf merge=unityyamlmerge
*.prefab      text eol=lf merge=unityyamlmerge
*.asset       text eol=lf merge=unityyamlmerge
*.mat         text eol=lf merge=unityyamlmerge
*.anim        text eol=lf merge=unityyamlmerge
*.controller  text eol=lf merge=unityyamlmerge
*.overrideController text eol=lf merge=unityyamlmerge
*.physicMaterial text eol=lf merge=unityyamlmerge
*.lighting    text eol=lf merge=unityyamlmerge
*.renderTexture text eol=lf merge=unityyamlmerge
*.shadergraph text eol=lf
*.inputactions text eol=lf
*.meta        text eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.psd  binary
*.tga  binary
*.exr  binary
*.hdr  binary
*.fbx  binary
*.FBX  binary
*.obj  binary
*.blend binary
*.glb  binary
*.gltf text
*.wav  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
*.dll  binary
*.zip  binary
